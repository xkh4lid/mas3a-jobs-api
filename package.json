{
  "name": "mas3a-jobs-api",
  "version": "3.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "check": "node --check src/index.js && node --experimental-wasm-modules --test && npm run build:check",
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:migrate": "wrangler d1 migrations apply DB --remote",
    "test": "node --test",
    "build:check": "wrangler deploy --dry-run --outdir .wrangler-dry-run"
  },
  "devDependencies": {
    "wrangler": "^4.36.0"
  },
  "dependencies": {
    "@resvg/resvg-wasm": "^2.6.2"
  }
}
